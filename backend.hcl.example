# Copy this file to backend.hcl and replace the placeholders with the values
# for the EXISTING remote state storage account. Do not commit backend.hcl.
resource_group_name  = "REPLACE_WITH_STATE_RESOURCE_GROUP"
storage_account_name = "REPLACE_WITH_STATE_STORAGE_ACCOUNT"
container_name       = "tfstate"
key                  = "shopsphere.terraform.tfstate"
use_azuread_auth     = true
use_cli              = true
