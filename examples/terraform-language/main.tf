terraform {
  required_version = ">= 1.5.0"
}

# Demonstrates count and count.index without provisioning Azure resources.
variable "frontend_vm_count" {
  description = "Number of demonstration frontend instances."
  type        = number
  default     = 3
}

resource "terraform_data" "frontend_demo" {
  count = var.frontend_vm_count

  input = {
    name  = "shopsphere-frontend-${count.index}"
    index = count.index
  }
}

output "frontend_demo_names" {
  description = "Names generated by the count demonstration."
  value       = terraform_data.frontend_demo[*].output.name
}

# Demonstrates locals and a conditional expression.
locals {
  environment = "development"
  vm_size     = local.environment == "production" ? "Standard_D2s_v3" : "Standard_B1s"
}

output "selected_vm_size" {
  description = "Example VM size selected from the environment local."
  value       = local.vm_size
}

# Demonstrates common Terraform string and collection functions.
output "function_demo" {
  description = "Examples of Terraform built-in functions."
  value = {
    lowercase = lower("SHOPSPHERE")
    uppercase = upper("devops")
    length    = length("Terraform")
    joined    = join("-", ["shopsphere", "api"])
    split     = split("-", "shopsphere-api")
  }
}

# Demonstrates a local module call using terraform_data only.
module "shopsphere_app" {
  source   = "../../modules/app"
  app_name = "shopsphere-api"
}

output "module_app_name" {
  description = "Application name returned by the example module."
  value       = module.shopsphere_app.app_name
}
